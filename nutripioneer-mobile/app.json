{
  "expo": {
    "name": "nutripioneer-mobile",
    "slug": "nutripioneer-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon-dark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutripioneer.mobile",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nutripioneer.mobile"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.260830587028-q0nfq6efvl8fh6s0lvdbqq2v25q3lr3g"
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Nutripioneer to use your location to find nearby grocery stores.",
          "locationForegroundPermission": "Allow Nutripioneer to use your location to find nearby grocery stores."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NutriPioneer to access your photos to scan restaurant menus so our third-party AI (OpenAI) can analyze them for dietary safety.",
          "cameraPermission": "Allow NutriPioneer to use your camera to photograph restaurant menus so our third-party AI (OpenAI) can analyze them for dietary safety."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}